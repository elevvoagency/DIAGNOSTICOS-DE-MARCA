# ── Servidor (Netlify → Project configuration → Environment variables) ──
# Nunca llegan al navegador: solo las usa la función /api/submit.

# OBLIGATORIA para recibir el PDF por correo (se obtiene en resend.com → API Keys)
RESEND_API_KEY=

# Opcionales
# Destino del correo (por defecto elevvocorp@gmail.com)
MAIL_TO=elevvocorp@gmail.com
# Remitente (por defecto ELEVVO Diagnóstico <onboarding@resend.dev>; con dominio verificado en Resend puedes usar diagnostico@elevvoagency.com)
# MAIL_FROM=ELEVVO Diagnóstico <onboarding@resend.dev>
# Además del correo, reenvía el JSON a un webhook (Make, n8n, Sheets...)
# WEBHOOK_URL=

# ── Frontend (opcionales) ──
# Número de WhatsApp del botón final (formato internacional, sin + ni espacios)
VITE_WHATSAPP_NUMBER=573104213595
# Enlace de Calendly (si se deja vacío, el botón no aparece)
VITE_CALENDLY_URL=
